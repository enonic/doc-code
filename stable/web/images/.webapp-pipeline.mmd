---
config:
  layout: elk
  elk:
    nodePlacementStrategy: NETWORK_SIMPLEX
---
flowchart TB
  in(["Common pipeline"])

  subgraph webapp["/webapp (Webapp service)"]
    direction TB
    route{"route by<br/>path"}
    route -->|"_/&lt;app&gt;:&lt;api&gt;"| api["Universal API"]
    route -->|"all other paths"| ctrl["webapp.ts<br/>GET / POST / …"]
  end

  out(["Common pipeline"])

  in -->|"/webapp/&lt;app-name&gt;/"| route
  api --> out
  ctrl --> out

  classDef platform fill:#ECECEC,stroke:#999,color:#000;
  classDef programmable fill:#C6DDFF,stroke:#979797,color:#000;
  classDef endpoint fill:#FFE0B2,stroke:#D79B00,color:#000;
  class route platform;
  class api,ctrl programmable;
  class in,out endpoint;

  style webapp fill:transparent,stroke:#9370DB;
